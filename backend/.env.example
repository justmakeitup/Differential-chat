# Use strong, distinct secrets in production:  python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_ENV=production
SECRET_KEY=replace-with-a-48-byte-random-secret
JWT_SECRET=replace-with-a-different-48-byte-random-secret

# Supabase: use the Session Pooler connection string from Connect, with sslmode=require.
# This value belongs ONLY on the backend host. Never place it in frontend/.env or commit it.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Exact deployed frontend origins, comma-separated. Do not use * when cookies are enabled.
CORS_ORIGINS=https://your-frontend.example
MAX_CONTENT_LENGTH=8388608

# Required for production password recovery. Use your transactional email provider's SMTP credentials.
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM_EMAIL=no-reply@your-domain.example
